# ── Modo de la app ─────────────────────────────────────────────
# "production" muestra solo datos reales. "demo" habilita replays de tormentas
# históricas, siempre etiquetados como REPLAY en la interfaz.
NEXT_PUBLIC_APP_MODE=production

# ── Supabase (región sa-east-1, São Paulo) ─────────────────────
# Sin estas variables la app funciona en "modo local": datos públicos en vivo y
# lugares guardados solo en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=

# ── Tareas programadas (Vercel Cron) ───────────────────────────
# Vercel envía "Authorization: Bearer $CRON_SECRET". Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Web Push (VAPID) ───────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operaciones@example.org

# ── Estimaciones propias ───────────────────────────────────────
# "shadow": se calculan y registran, pero NO se notifican como avisos.
# "live" requiere revisión meteorológica/hidrológica documentada (docs/lanzamiento.md).
OWN_ESTIMATES_MODE=shadow

# Identificación en los pedidos a fuentes públicas (buena práctica de cortesía).
SOURCES_USER_AGENT=MeteoLAB/0.1 (+https://github.com/martinxr250/Meteo-LAB)
